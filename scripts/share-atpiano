#!/usr/bin/env bash
set -euo pipefail

system_name="$(uname -s 2>/dev/null || printf 'unknown')"
if [[ "${system_name}" != "Darwin" ]]; then
  printf 'error: scripts/share-atpiano requires macOS because it uses caffeinate; detected %s.\n' \
    "${system_name}" >&2
  printf 'Use "uv run atpiano workbench-v3" for an ordinary local server on this host.\n' >&2
  exit 69
fi

bind_address="${ATPIANO_BIND_ADDRESS:-192.168.1.104}"
port="${ATPIANO_PORT:-8002}"
public_origin="${ATPIANO_PUBLIC_ORIGIN:-https://atpiano.graehlarts.com}"
model_idle_timeout_seconds="${ATPIANO_MODEL_IDLE_TIMEOUT_SECONDS:-600}"
family_auth="${ATPIANO_FAMILY_AUTH:-false}"
score_runtime="${ATPIANO_SCORE_RUNTIME:-${ATPIANO_PUBLIC_SCORE_RUNTIME:-results/midi2score-runtime}}"
backend_profile="${ATPIANO_BACKEND_PROFILE:-results/backend-profile/backend-profile.json}"
uv_path="${ATPIANO_UV:-$(command -v uv || true)}"

if [[ -z "${uv_path}" || ! -x "${uv_path}" ]]; then
  printf 'error: no executable uv was found; set ATPIANO_UV to its absolute path.\n' >&2
  exit 69
fi

if [[ "${family_auth}" != "true" && "${family_auth}" != "false" ]]; then
  printf 'error: ATPIANO_FAMILY_AUTH must be true or false.\n' >&2
  exit 64
fi

server_command="workbench-v3"
selected_score_runtime="${score_runtime}"
if [[ "${family_auth}" == "true" ]]; then
  server_command="family-server"
else
  selected_score_runtime="${ATPIANO_PUBLIC_SCORE_RUNTIME:-results/public-score-disabled}"
fi

server_arguments=(
  --bind "${bind_address}"
  --port "${port}"
  --public-origin "${public_origin}"
  --model-idle-timeout-seconds "${model_idle_timeout_seconds}"
  --backend-profile "${backend_profile}"
  --score-runtime "${selected_score_runtime}"
  --no-open
)

exec /usr/bin/caffeinate -im "${uv_path}" run atpiano "${server_command}" \
  "${server_arguments[@]}" \
  "$@"
