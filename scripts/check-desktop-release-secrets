#!/usr/bin/env bash
set -euo pipefail

repository="${1:-kzahel/atpiano}"
required=(
  TAURI_SIGNING_PRIVATE_KEY
  TAURI_SIGNING_PRIVATE_KEY_PASSWORD
  MACOS_CERTIFICATE_P12_BASE64
  MACOS_CERTIFICATE_PASSWORD
  MACOS_KEYCHAIN_PASSWORD
  ASC_API_KEY_P8_BASE64
  ASC_API_KEY_ID
  ASC_API_ISSUER_ID
  AZURE_CLIENT_ID
  AZURE_TENANT_ID
  AZURE_CLIENT_SECRET
)

resolved="$(gh repo view "${repository}" --json nameWithOwner --jq .nameWithOwner)"
if [[ "${resolved}" != "kzahel/atpiano" ]]; then
  printf 'refusing unexpected repository: %s\n' "${resolved}" >&2
  exit 1
fi

metadata="$(
  gh secret list \
    --repo "${resolved}" \
    --app actions \
    --json name,updatedAt \
    --jq '.[] | [.name, .updatedAt] | @tsv'
)"
missing=0
for name in "${required[@]}"; do
  record="$(printf '%s\n' "${metadata}" | awk -F '\t' -v name="${name}" \
    '$1 == name { print; exit }')"
  if [[ -n "${record}" ]]; then
    printf 'configured\t%s\n' "${record}"
  else
    printf 'missing\t%s\n' "${name}" >&2
    missing=$((missing + 1))
  fi
done

if [[ "${missing}" -ne 0 ]]; then
  printf '%s of %s required Actions secrets are missing\n' \
    "${missing}" "${#required[@]}" >&2
  exit 1
fi
printf 'All %s required Actions secret names are configured on %s.\n' \
  "${#required[@]}" "${resolved}"
