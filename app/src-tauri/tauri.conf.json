{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atpiano",
  "version": "0.1.3",
  "identifier": "com.atpiano.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Atpiano · Performance workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; media-src 'self' blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    },
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Kyle Graehl (VD7BYQ6ABM)",
      "hardenedRuntime": true,
      "entitlements": "entitlements/app.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.graehlarts.com/atpiano/tauri/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MjQwQzM2NjQ2ODE2NApSV1JrZ1VabXcwQkNCdy9lVDFzRDdnRnpweFFKUWsvZXI2cjB6SHRTbUFtR05INWZVV1NDQXpiKwo="
    }
  }
}
