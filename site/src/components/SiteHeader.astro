---
interface Props {
  homeHref?: string;
}

const { homeHref = "/" } = Astro.props;
---

<header class="site-header">
  <nav class="shell site-nav" aria-label="Main navigation">
    <a class="brand" href={homeHref} aria-label="Atpiano home">
      <span class="brand-mark" aria-hidden="true">A</span>
      <span>atpiano</span>
    </a>
    <div class="nav-links">
      <a href="/#how-it-works">How it works</a>
      <a href="/#hosted">Hosted</a>
      <a href="https://github.com/kzahel/atpiano">Source</a>
      <a class="nav-download" href="/download/">Download</a>
    </div>
  </nav>
</header>
